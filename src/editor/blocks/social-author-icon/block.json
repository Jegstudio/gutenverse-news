{
    "apiVersion": 3,
    "name": "gutenverse/news-social-author-icon",
    "title": "Social Icon Author",
	"parent": ["gutenverse/social-icons"],
    "class_callback": "\\GUTENVERSE\\NEWS\\Block\\Social_Author_Icon",
    "description": "Display the author's social media icon.",
    "category": "gvnews-single-post",
    "attributes": {
        "elementId": {
            "type": "string"
        },
        "authorType": {
            "type": "string",
            "default": "dynamic"
        },
        "socialMedia": {
            "type": "object",
            "default": {}
        },
        "hideIfEmpty": {
            "type": "boolean",
            "default": false
        },
        "defaultUrl": {
            "type": "string"
        },
        "authorId": {
            "type": "object"
        },
        "icon": {
            "type": "string",
            "default": "fab fa-wordpress"
        },
        "iconSize": {
             "type": "object"
        },
        "iconColor": {
             "type": "object"
        },
        "iconColorHover": {
             "type": "object"
        },
        "iconBackground": {
             "type": "object"
        },
        "iconBackgroundHover": {
             "type": "object"
        },
        "iconBackgroundGradient": {
             "type": "object"
        },
        "iconBackgroundGradientHover": {
             "type": "object"
        },
         "margin": {
            "type": "object"
        },
        "padding": {
            "type": "object"
        },
        "zIndex": {
            "type": "object"
        },
        "animation": {
            "type": "object",
            "default": {}
        },
        "hideDesktop": {
            "type": "boolean"
        },
        "hideTablet": {
            "type": "boolean"
        },
        "hideMobile": {
            "type": "boolean"
        },
        "condition": {
            "type": "object",
            "default": {}
        }
    },
    "supports": {
        "className": false
    },
    "keywords": [
        "social",
        "author",
        "icon"
    ],
    "style": ["gutenverse-news-frontend-social-author-icon-style"]
}
